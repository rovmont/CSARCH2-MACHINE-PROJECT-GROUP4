---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Convert · decimal32">
  <h1 class="page-title">Convert to decimal32</h1>
  <p class="lede">
    Convert a decimal value into IEEE 754 decimal32 (single-precision). The result is shown
    as a spaced binary encoding and as hexadecimal, including special cases such as
    ±0, ±Infinity, and NaN.
  </p>

  <section class="panel">
    <form id="convert-form" class="form-grid">
      <label>
        Decimal number
        <input
          id="convert-input"
          name="value"
          placeholder="e.g. -12.34, 1e10, 1.11 x 10^4"
          required
        />
      </label>
      <p class="hint">
        Accepts plain decimals or scientific notation (<code>1e10</code>, <code>1.11 x 10^4</code>).
      </p>
      <button class="btn btn-primary" type="submit">Convert</button>
    </form>
    <p id="convert-error" class="error" hidden></p>
    <div id="convert-results" class="results" hidden></div>
  </section>
</BaseLayout>

<script>
  import { convertToDecimal32 } from '../lib/decimal32/index.js';
  import { esc, overviewFromBits, renderStepList } from '../lib/render/stepViz.js';

  const form = document.getElementById('convert-form');
  const input = document.getElementById('convert-input');
  const err = document.getElementById('convert-error');
  const out = document.getElementById('convert-results');

  function render(result) {
    out.hidden = false;
    err.hidden = true;
    const flags = (result.flags || [])
      .map((f) => `<span class="flag">${esc(f)}</span>`)
      .join('');

    out.innerHTML = `
      <div class="result-row"><strong>Binary (spaced)</strong><code>${esc(result.spacedBinary)}</code></div>
      <div class="result-row"><strong>Hexadecimal</strong><code>${esc(result.hex)}</code></div>
      <div class="result-row result-overview">
        <strong>Field map</strong>
        ${overviewFromBits(result.bits)}
      </div>
      <div class="flags">${flags}</div>
      ${renderStepList(result.steps)}
    `;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    try {
      render(convertToDecimal32(input.value));
    } catch (ex) {
      out.hidden = true;
      err.hidden = false;
      err.textContent = ex.message || String(ex);
    }
  });
</script>
