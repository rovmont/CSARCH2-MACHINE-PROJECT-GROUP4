---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Machine 4 · Decimal32">
  <section class="hero">
    <h1>Machine 4<br /><span>decimal32</span></h1>
    <p>
      IEEE 754 decimal single-precision simulator using Densely Packed Decimal (DPD).
      Convert, round, subtract, and divide — with spaced binary, hexadecimal, and step traces.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href={`${base}convert/`}>Start converting</a>
      <a class="btn" href={`${base}arithmetic/`}>Try arithmetic</a>
    </div>
  </section>

  <div class="feature-cards">
    <a href={`${base}convert/`}>
      <h3>1 · Convert</h3>
      <p>Decimal → decimal32 with special cases, spaced binary fields, and hex.</p>
    </a>
    <a href={`${base}round/`}>
      <h3>2 · Round</h3>
      <p>Chopping, round-up, round-down, and ties-to-even side by side.</p>
    </a>
    <a href={`${base}arithmetic/`}>
      <h3>3 · Arithmetic</h3>
      <p>Subtraction and division with rounding and full step-by-step output.</p>
    </a>
  </div>
</BaseLayout>
