---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Round · decimal32">
  <h1 class="page-title">Rounding methods</h1>
  <p class="lede">
    Demonstrate the four IEEE-style rounding methods on a decimal or binary number.
    Choose how many digits to keep; results are shown for chopping, round-up, round-down,
    and round-to-nearest ties-to-even.
  </p>

  <section class="panel">
    <form id="round-form" class="form-grid">
      <label>
        Number
        <input id="round-input" name="value" placeholder="e.g. 1.23456789 or 1011011" required />
      </label>
      <label>
        Target number of digits
        <input id="round-digits" name="digits" type="number" min="1" max="32" value="7" required />
      </label>
      <label>
        Input format
        <select id="round-radix" name="radix">
          <option value="decimal">Decimal</option>
          <option value="binary">Binary</option>
        </select>
      </label>
      <button class="btn btn-primary" type="submit">Round all methods</button>
    </form>
    <p id="round-error" class="error" hidden></p>
    <div id="round-results" class="results" hidden></div>
  </section>
</BaseLayout>

<script>
  import { demonstrateRounding } from '../lib/decimal32/index.js';
  import { esc, renderParts, renderStepList } from '../lib/render/stepViz.js';

  const form = document.getElementById('round-form');
  const err = document.getElementById('round-error');
  const out = document.getElementById('round-results');

  const labels = {
    chopping: 'Chopping (truncation)',
    'round-up': 'Round-up (toward +∞)',
    'round-down': 'Round-down (toward −∞)',
    'ties-to-even': 'Round-to-nearest ties-to-even',
  };

  function render(demo) {
    err.hidden = true;
    out.hidden = false;

    const overview = renderParts({
      type: 'parts',
      parts: [
        { label: 'Sign', value: demo.sign === 1 ? 'Negative (−)' : 'Positive (+)', tone: 'neutral' },
        { label: 'Original digits', value: demo.originalDigits, tone: 'msd' },
        { label: 'Target digits', value: String(demo.targetDigits), tone: 'exp' },
        { label: 'Radix', value: demo.radix, tone: 'neutral' },
      ],
    });

    const modeSections = Object.entries(demo.results)
      .map(
        ([mode, r]) => `
        <div class="result-row">
          <strong>${esc(labels[mode])}</strong>
          <code>${esc(r.formatted)}</code>
          ${renderStepList(r.steps)}
        </div>`
      )
      .join('');

    out.innerHTML = `
      <div class="result-row result-overview">
        <strong>Rounding input</strong>
        ${overview}
      </div>
      ${modeSections}
    `;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    try {
      const value = document.getElementById('round-input').value;
      const digits = Number(document.getElementById('round-digits').value);
      const radix = document.getElementById('round-radix').value;
      render(demonstrateRounding(value, digits, radix));
    } catch (ex) {
      out.hidden = true;
      err.hidden = false;
      err.textContent = ex.message || String(ex);
    }
  });
</script>
