---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Arithmetic · decimal32">
  <h1 class="page-title">Subtraction &amp; division</h1>
  <p class="lede">
    Perform decimal32 subtraction or division on two operands entered as decimal values
    or IEEE hexadecimal. Select a rounding method for the operation. The final result is
    reported in decimal, spaced binary, and hexadecimal, including special cases.
  </p>

  <section class="panel">
    <form id="arith-form" class="form-grid">
      <label>
        Operand A format
        <select id="op-a-format" name="aFormat">
          <option value="decimal">Decimal</option>
          <option value="hex">IEEE hexadecimal</option>
        </select>
      </label>
      <label>
        Operand A
        <input id="op-a" name="a" placeholder="e.g. 10.5" required />
      </label>
      <label>
        Operand B format
        <select id="op-b-format" name="bFormat">
          <option value="decimal">Decimal</option>
          <option value="hex">IEEE hexadecimal</option>
        </select>
      </label>
      <label>
        Operand B
        <input id="op-b" name="b" placeholder="e.g. 2.25" required />
      </label>
      <label>
        Operation
        <select id="op-type" name="op">
          <option value="subtract">Subtraction (A − B)</option>
          <option value="divide">Division (A ÷ B)</option>
        </select>
      </label>
      <label>
        Rounding method
        <select id="op-round" name="round">
          <option value="ties-to-even">Ties-to-even</option>
          <option value="chopping">Chopping</option>
          <option value="round-up">Round-up</option>
          <option value="round-down">Round-down</option>
        </select>
      </label>
      <button class="btn btn-primary" type="submit">Compute</button>
    </form>
    <p id="arith-error" class="error" hidden></p>
    <div id="arith-results" class="results" hidden></div>
  </section>
</BaseLayout>

<script>
  import {
    subtractDecimal32,
    divideDecimal32,
    parseArithmeticOperand,
  } from '../lib/decimal32/index.js';

  const form = document.getElementById('arith-form');
  const err = document.getElementById('arith-error');
  const out = document.getElementById('arith-results');
  const opA = document.getElementById('op-a');
  const opB = document.getElementById('op-b');
  const formatA = document.getElementById('op-a-format');
  const formatB = document.getElementById('op-b-format');

  function syncPlaceholder(input, formatSelect) {
    input.placeholder =
      formatSelect.value === 'hex' ? 'e.g. 22500000' : 'e.g. 10.5';
  }

  formatA.addEventListener('change', () => syncPlaceholder(opA, formatA));
  formatB.addEventListener('change', () => syncPlaceholder(opB, formatB));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    try {
      const a = parseArithmeticOperand(opA.value, formatA.value);
      const b = parseArithmeticOperand(opB.value, formatB.value);
      const op = document.getElementById('op-type').value;
      const mode = document.getElementById('op-round').value;
      const result = op === 'divide' ? divideDecimal32(a, b, mode) : subtractDecimal32(a, b, mode);
      err.hidden = true;
      out.hidden = false;
      const flags = (result.flags || [])
        .map((f) => `<span class="flag">${f}</span>`)
        .join('');
      out.innerHTML = `
        <div class="result-row"><strong>Decimal</strong><code>${result.decimal}</code></div>
        <div class="result-row"><strong>Binary (spaced)</strong><code>${result.spacedBinary}</code></div>
        <div class="result-row"><strong>Hexadecimal</strong><code>${result.hex}</code></div>
        <div class="flags">${flags}</div>
        <ol class="steps">${result.steps.map((s) => `<li>${typeof s === 'string' ? s : `${s.title}: ${s.text}`}</li>`).join('')}</ol>
      `;
    } catch (ex) {
      out.hidden = true;
      err.hidden = false;
      err.textContent = ex.message || String(ex);
    }
  });
</script>
