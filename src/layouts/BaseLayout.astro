---
import '../styles/global.css';

const { title = 'Machine 4 · decimal32' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-bg" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href={base}>decimal32</a>
      <nav class="nav">
        <a href={base}>Home</a>
        <a href={`${base}convert/`}>Convert</a>
        <a href={`${base}round/`}>Round</a>
        <a href={`${base}arithmetic/`}>Arithmetic</a>
      </nav>
    </header>
    <main class="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>CSARCH2 · Group 4 · Machine 4 · IEEE 754 decimal32 (DPD)</p>
    </footer>
  </body>
</html>
